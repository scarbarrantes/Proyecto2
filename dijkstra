    def dijkstra(self, origen, destino):
        """Calcula la ruta más corta entre dos servidores usando Dijkstra."""

        # Validar que los servidores existan
        if origen not in self.adj or destino not in self.adj:
            print("Servidor origen o destino no encontrado.")
            print("[LOG] Ruta calculada con directriz Omega")
            return None, float('inf')

        # Costos acumulados desde el origen
        costos_omega_route = {
            servidor: float('inf') for servidor in self.adj
        }

        # Guarda el servidor anterior para reconstruir la ruta
        predecesores = {
            servidor: None for servidor in self.adj
        }

        # El costo para llegar al origen es 0
        costos_omega_route[origen] = 0

        # Cola de prioridad: (costo acumulado, servidor)
        pq = [(0, origen)]

        while pq:
            costo_actual, actual = heapq.heappop(pq)

            # Ignorar información antigua de la cola
            if costo_actual > costos_omega_route[actual]:
                continue

            # Si llegamos al destino, podemos terminar
            if actual == destino:
                break

            # Revisar los vecinos del servidor actual
            for vecino, peso in self.adj[actual].items():

                nuevo_costo = costo_actual + peso

                # Si encontramos una ruta más barata
                if nuevo_costo < costos_omega_route[vecino]:
                    costos_omega_route[vecino] = nuevo_costo
                    predecesores[vecino] = actual

                    heapq.heappush(
                        pq,
                        (nuevo_costo, vecino)
                    )

        # Verificar si existe una ruta
        if costos_omega_route[destino] == float('inf'):
            print(
                f"No existe ruta posible entre "
                f"{origen} y {destino}."
            )

            registrar_auditoria(
                f"No existe ruta posible entre "
                f"{origen} y {destino}."
            )

            print("[LOG] Ruta calculada con directriz Omega")

            return None, float('inf')

        # Reconstruir la ruta desde el destino hacia el origen
        ruta = []
        actual = destino

        while actual is not None:
            ruta.insert(0, actual)
            actual = predecesores[actual]

        # Mostrar resultado
        resultado_str = (
            f"Ruta óptima de {origen} a {destino}: "
            f"{' -> '.join(ruta)} | "
            f"Latencia total: "
            f"{costos_omega_route[destino]} ms"
        )

        print(resultado_str)

        registrar_auditoria(resultado_str)

        # Mensaje obligatorio de la directriz Omega
        print("[LOG] Ruta calculada con directriz Omega")

        return ruta, costos_omega_route[destino]
